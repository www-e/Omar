{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": "allow",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true,
      "timeout": 5000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true,
      "timeout": 5000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ],
      "enabled": true,
      "timeout": 5000
    },
    "carl": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\omara\\.carl\\carl-mcp\\index.js"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "codedev": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "codedev-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "trace-mcp": {
      "type": "local",
      "command": [
        "trace-mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "engram": {
      "type": "local",
      "command": [
        "engram-mcp-server",
        "--mode=universal",
        "--project-root",
        "D:\\clones\\edrak"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "git": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "mcp_server_git",
        "--repository",
        "D:\\clones\\edrak"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": [
    "context-mode",
    "@slkiser/opencode-quota"
  ]
}
